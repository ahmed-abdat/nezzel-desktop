# Copy to .env.local (git-ignored) and fill in our own keys.
# Empty values switch the feature off; nothing is sent.
# Rust side reads this at compile time (export it before `pnpm tauri build`).
NEZZEL_SENTRY_DSN=
# Optional signed tool updates. Export BOTH before `pnpm tauri dev` / `pnpm tauri build`;
# Rust option_env! does not load .env.local. Unset/blank either = no remote manifest;
# first-run setup uses the bundled, pinned tool URLs and SHA-256 hashes instead.
# URL is the full HTTPS manifest.json URL on our own host. manifest.sig must be
# beside it (base64 Ed25519 signature of the exact JSON bytes).
# PUBKEY is our Ed25519 verifying key as 64 hexadecimal characters (32 bytes).
NEZZEL_MANIFEST_URL=
NEZZEL_MANIFEST_PUBKEY=

# Usage counts ("Help improve Nezzel", docs/specs/usage-counts.md): the full HTTPS URL of our
# own inbox, e.g. https://nezzel.hululsoft.mr/api/usage. Unset or empty = nothing is counted or
# sent. Debug builds never send.
NEZZEL_USAGE_URL=
