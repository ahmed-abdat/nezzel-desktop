{
  "name": "nezzel-desktop",
  "version": "0.1.0-beta.3",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmed-abdat/nezzel-desktop.git"
  },
  "scripts": {
    "dev": "cross-env DEV=true vite",
    "build": "pnpm run build:app && pnpm run build:isolation",
    "build:app": "vue-tsc --noEmit && vite build",
    "build:isolation": "vue-tsc --noEmit && vite build --config vite.config.isolation.ts",
    "tauri": "tauri",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "rust:clippy": "cargo clippy --manifest-path=src-tauri/Cargo.toml --all-features --all-targets -- -D warnings",
    "rust:fmt": "cargo fmt --manifest-path=src-tauri/Cargo.toml --all",
    "rust:lint": "pnpm run rust:fmt && pnpm run rust:clippy",
    "rust:test": "cargo test --manifest-path=src-tauri/Cargo.toml --all-features --all-targets",
    "test:unit": "vitest run",
    "test:tools": "python3 -B -m unittest discover -s scripts -p \"test_*.py\"",
    "test:push": "pnpm run lint --cache --cache-strategy content --cache-location node_modules/.cache/eslint && pnpm exec vue-tsc --noEmit && pnpm run test:unit",
    "test:e2e": "playwright test",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "manifest:gen": "node scripts/gen-manifest.ts",
    "manifest:sign": "node scripts/sign-manifest.ts",
    "manifest:verify": "node scripts/verify-manifest.ts",
    "manifest:fetch": "node scripts/fetch-sources.ts",
    "licenses:npm": "license-checker-rseidelsohn --production --json --out licenses/licenses-npm.json",
    "licenses:rust": "cargo about generate --manifest-path=src-tauri/Cargo.toml --output-file licenses/licenses-rust.txt src-tauri/about.hbs",
    "licenses:gen": "node scripts/licenses.ts",
    "licenses": "pnpm run licenses:npm && pnpm run licenses:rust && pnpm run licenses:gen",
    "prepare": "node -e \"const{execSync:x}=require('child_process'),{realpathSync:r}=require('fs');try{if(r(x('git rev-parse --show-toplevel',{encoding:'utf8',stdio:['ignore','pipe','ignore']}).trim())===r(process.cwd()))x('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\""
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@internationalized/date": "3.12.4",
    "@lucide/vue": "1.66.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@vueuse/core": "14.4.0",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "iso-639-1": "^3.1.6",
    "pinia": "^4.1.0",
    "reka-ui": "2.11.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "uuid": "^14.0.3",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.17",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "2.5.1",
    "cross-env": "^10.1.0",
    "daisyui": "^5.7.50",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^30.1.3",
    "license-checker-rseidelsohn": "^5.0.1",
    "monocart-coverage-reports": "^3.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unzipper": "^0.12.5",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "vite-plugin-vue-devtools": {
      "vite-plugin-inspect": "^11.3.3"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.22.2"
  }
}
